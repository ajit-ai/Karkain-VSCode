{
  "name": "Karkain",
  "scopeName": "source.karkain",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#functionDefinition"
    },
    {
      "include": "#typeDefinition"
    },
    {
      "include": "#variableDeclaration"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#identifier"
    }
  ],
  "repository": {
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.karkain"
    },
    "string": {
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.karkain" }
      },
      "end": "\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.karkain" }
      },
      "name": "string.quoted.double.karkain",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.karkain"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b",
          "name": "constant.numeric.float.karkain"
        },
        {
          "match": "\\b\\d+\\b",
          "name": "constant.numeric.integer.karkain"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(func|fn|let|var|if|else|while|for|in|return|break|continue|match|import|type|struct|enum|matrix|macro|quote|unquote|comptime|public|linear|packed)\\b",
          "name": "keyword.control.karkain"
        },
        {
          "match": "\\b(print|println)\\b",
          "name": "support.function.builtin.karkain"
        },
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.karkain"
        },
        {
          "match": "\\b(Some|None|Ok|Err)\\b",
          "name": "constant.language.karkain"
        },
        {
          "match": "\\b(int|float64|string|bool|bigint|bigfloat|void)\\b",
          "name": "support.type.primitive.karkain"
        },
        {
          "match": "\\b(kernel|device|global_id|barrier|qreg|gate|measure|actor|spawn|receive|channel|send|alloc|free|addr|mut|raw|move)\\b",
          "name": "keyword.other.karkain"
        }
      ]
    },
    "functionDefinition": {
      "begin": "\\b(func|fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.control.karkain" },
        "2": { "name": "entity.name.function.karkain" }
      },
      "end": "(?=\\{)",
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "name": "meta.function.parameters.karkain"
        }
      ]
    },
    "typeDefinition": {
      "begin": "\\b(struct|enum|type|matrix)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "storage.type.karkain" },
        "2": { "name": "entity.name.type.karkain" }
      },
      "end": "(?=\\{|$)"
    },
    "variableDeclaration": {
      "begin": "\\b(let|var)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.control.karkain" },
        "2": { "name": "variable.other.karkain" }
      },
      "end": "(?==|$|;)"
    },
    "operator": {
      "match": "==|!=|<=|>=|&&|\\|\\||->|=>|[+\\-*/%<>=!&@.?]",
      "name": "keyword.operator.karkain"
    },
    "punctuation": {
      "match": "[\\(\\)\\[\\]\\{\\},;:]",
      "name": "punctuation.bracket.karkain"
    },
    "identifier": {
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
      "name": "variable.other.karkain"
    }
  }
}
